# =============================================================================
# BoraMarcar Backend - variáveis de ambiente
# Copie para .env e preencha com valores reais. Nunca commite o .env.
# Ao adicionar uma nova variável no código, atualize ESTE arquivo no mesmo PR.
# =============================================================================

# Ambiente da aplicação (exposto em GET /health). Valores: development | hml | production
APP_ENV=development

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
# OBRIGATÓRIO: service_role secret (JWT longo, eyJ...). NÃO use a anon key.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Price IDs por plano (price_..., NÃO prod_...). Products → plano → Pricing.
STRIPE_SOLO_PRICE_ID=price_replace_solo_monthly
STRIPE_PRO_TIER_PRICE_ID=price_replace_pro_monthly
STRIPE_ELITE_PRICE_ID=price_replace_elite_monthly
# Legado: usado como fallback do plano Solo se STRIPE_SOLO_PRICE_ID estiver vazio
STRIPE_PRO_PRICE_ID=price_replace_legacy_or_solo

# URLs de retorno do Checkout (front admin / faturamento)
STRIPE_BILLING_SUCCESS_URL=http://localhost:5173/admin/faturamento?success=true
STRIPE_BILLING_CANCEL_URL=http://localhost:5173/admin/faturamento?canceled=true
# Retorno do Stripe Customer Portal (troca de plano, cancelamento, cartão)
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/admin/faturamento?portal=return

# URLs de retorno do pagamento de sinal (agendamento público / plano Elite)
STRIPE_DEPOSIT_SUCCESS_URL=http://localhost:5173/booking/success?success=true
STRIPE_DEPOSIT_CANCEL_URL=http://localhost:5173/booking/canceled

# Stripe Connect (sinal vai para a conta do estabelecimento)
# Retorno após o dono concluir o cadastro no Stripe (Configurações)
STRIPE_CONNECT_ONBOARDING_RETURN_URL=http://localhost:5173/admin/configuracoes?stripe_connect=return
STRIPE_CONNECT_ONBOARDING_REFRESH_URL=http://localhost:5173/admin/configuracoes?stripe_connect=refresh
# Taxa padrão da plataforma sobre o sinal em percentual inteiro (ex.: 5 = 5%, não use 0.05).
# Por tenant: NULL em tenants.deposit_application_fee_percent usa este valor; 0 = isento; ex.: 3 = 3%.
STRIPE_CONNECT_APPLICATION_FEE_PERCENT=0

# Webhook signing secret (Stripe CLI: stripe listen --forward-to localhost:3333/billing/webhook)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# SMTP (confirmações B2C, avisos ao responsável e lembretes de agendamento)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="BoraMarcar <noreply@example.com>"

# E-mail de destino das solicitações de suporte enviadas pelo painel admin
SUPPORT_EMAIL=support@example.com

# URL pública do frontend (convites de equipe e links OAuth)
FRONTEND_URL=http://localhost:5173

# Porta HTTP da API (opcional; padrão 3333 se vazio).
PORT=3333

# E2E (Playwright) — opcional. Senha usada nos testes de login do browser.
# Padrão: 123456 (sincronizada via service_role no global-setup).
# E2E_TEST_PASSWORD=123456
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:3333

# Origens permitidas pelo CORS (separadas por vírgula, sem espaços entre URLs).
# Omita ou deixe vazio para liberar qualquer origem (use só em HML/dev).
# Em produção, liste os domínios reais do frontend.
ALLOWED_ORIGINS=http://localhost:5173,https://boramarcar.com.br,https://www.boramarcar.com.br
