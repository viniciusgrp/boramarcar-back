# URL do projeto (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# OBRIGATÓRIO no backend: service_role secret (JWT longo, começa com eyJ...)
# Project Settings → API → service_role → Reveal
# NÃO use a anon key nem chaves curtas de referência aqui.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (assinatura B2B)
STRIPE_SECRET_KEY=sk_test_mock_replace_with_your_stripe_secret_key
# Price ID (price_...), NÃO o Product ID (prod_...). Em Products → seu plano → Pricing → copie o ID do preço recorrente.
STRIPE_PRO_PRICE_ID=price_mock_replace_with_your_stripe_price_id
STRIPE_BILLING_SUCCESS_URL=http://localhost:5173/admin/faturamento?success=true
STRIPE_BILLING_CANCEL_URL=http://localhost:5173/admin/faturamento?canceled=true
# Signing secret do endpoint de webhook (Stripe CLI: stripe listen --forward-to localhost:3333/billing/webhook)
STRIPE_WEBHOOK_SECRET=whsec_mock_replace_with_your_webhook_signing_secret
